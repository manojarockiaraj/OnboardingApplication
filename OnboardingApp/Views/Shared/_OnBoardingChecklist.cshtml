@model IEnumerable<OnboardingApp.Models.OnBoardingList>

@{
    // Make a safe list
    var candidate = ViewData["Candidate"] as Candidate;
    var items = ViewData["OnBoardingItems"] as IEnumerable<OnboardingApp.Models.OnBoardingList>;


    // Summary counts

    var totalItems = items.Count();
    var completedItems = items.Count(x => !x.isactive);
    var pendingItems = totalItems - completedItems;

    // Welcome Pack items (title contains 'Welcome')
    var welcomePack = items
        .Where(x => x.title.Contains("Welcome", StringComparison.OrdinalIgnoreCase))
        .ToList();

    // Other onboarding items
    var onboardingItems = items.Except(welcomePack).ToList();
}

@if (!items.Any())
{
    <div class="alert alert-secondary text-center">
        No onboarding items available.
    </div>
}
else
{
    <!-- ================= SUMMARY ================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
           <h4 class="mb-1">Welcome Aboard 👋 </h4>  @* <h1>@candidate?.Name</h1>*@
            @* <p class="text-muted mb-3">
                     Here's your onboarding progress
                 </p>

                <div class="row text-center mb-3">
                     <div class="col">
                         <h5>@totalItems</h5>
                         <small class="text-muted">Total</small>
                     </div>
                     <div class="col">
                         <h5>@completedItems</h5>
                         <small class="text-muted">Completed</small>
                     </div>
                     <div class="col">
                         <h5>@pendingItems</h5>
                         <small class="text-muted">Pending</small>
                     </div>
                 </div>

                 <div class="progress">
                     <div class="progress-bar bg-success"
                          role="progressbar"
                          style="width:@(totalItems == 0 ? 0 : completedItems * 100 / totalItems)%">
                     </div>
                 </div>*@
        </div>
    </div>

    @if (candidate != null)
    {
        @await Html.PartialAsync("_CandidateProfile", candidate)
    }



    <!-- ================= WELCOME PACK ================= -->
    @if (welcomePack.Any())
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white fw-semibold">
                🎁 Welcome Pack
            </div>

            <ul class="list-group list-group-flush">
                @foreach (var item in welcomePack.OrderBy(x => x.Id))
                {
                    <li class="list-group-item">
                        <div class="fw-semibold">@item.title</div>
                        <div class="text-muted small">@item.description</div>
                    </li>
                }
            </ul>
        </div>
    }

    <!-- ================= ONBOARDING ITEMS BY TYPE ================= -->
    @foreach (var typeGroup in onboardingItems.GroupBy(x => x.type))
    {
        @if (typeGroup.Key.Equals("Checkbox", StringComparison.OrdinalIgnoreCase))
        {
            <!-- Checkbox items grouped by Title -->
            @foreach (var titleGroup in typeGroup.GroupBy(x => x.title))
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-header fw-bold">
                        @titleGroup.Key
                    </div>

                    <ul class="list-group list-group-flush">
                        @foreach (var item in titleGroup.OrderBy(x => x.Id))
                        {
                            <li class="list-group-item">
                                <div class="d-flex align-items-start gap-3">
                                    <input type="checkbox"
                                           class="form-check-input mt-1"
                                           disabled
                                           checked="@(item.isactive)" />

                                    <div class="flex-grow-1">
                                        <div>@item.description</div>
                                    </div>

                                    @if (!item.isactive)
                                    {
                                        <span class="badge bg-success ms-auto">Done</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
        else
        {
            <!-- Text & URL items -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header d-flex justify-content-between">

                    <span class="fw-bold">@(typeGroup.Key =="URL" ? "Training" : "Policies")</span>
                    <!--<span class="fw-bold">@typeGroup.Key</span>-->
                    @*<span class="badge bg-secondary">@typeGroup.Count()</span>*@
                </div>

                <ul class="list-group list-group-flush">
                    @foreach (var item in typeGroup.OrderBy(x => x.Id))
                    {
                        <li class="list-group-item">
                            <div class="fw-semibold">@item.title</div>

                            @if (typeGroup.Key.Equals("URL", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@item.description" target="_blank" rel="noopener" class="link-primary">
                                    Open link
                                </a>
                            }
                            else
                            {
                                <div class="text-muted small">@item.description</div>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    }

    @if (candidate != null)
    {

        <div class="card mb-4 shadow-sm">
            <div class="card-header d-flex justify-content-between">

                <span class="fw-bold">Acknowledgement</span>

            </div>

            <ul class="list-group list-group-flush">

                <li class="list-group-item">

                    <form asp-action="ConfirmAcknowledgement" method="post">
                        <div class="text-muted small">
                            Confirm and accept your acknowledgement of service.
                        </div>

                        <!-- Yes/No Options -->
                        <input type="radio" name="AcknowledgmentConfirmed" value="true" id="ackYes" @(candidate.AcknowledgmentConfirmed ? "checked" : "") />
                        <label for="ackYes">Yes</label>

                        <input type="radio" name="AcknowledgmentConfirmed" value="false" id="ackNo" @(!candidate.AcknowledgmentConfirmed ? "checked" : "") />
                        <label for="ackNo">No</label>

                        <input type="hidden" name="Id" value="@candidate.Id" />


                        <!-- Accept / Reject Buttons -->
                        <div class="mt-3">
                            <button type="submit" class="btn btn-success me-2">
                                <i class="fas fa-check me-1"></i> Accept
                            </button>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-times me-1"></i> Reject
                            </button>
                        </div>
                    </form>

                </li>

            </ul>
        </div>

    }
}
