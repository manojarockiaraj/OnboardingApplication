@model IEnumerable<OnboardingApp.Models.OnBoardingList>

@if (Model == null || !Model.Any())
{
    <p class="text-muted">No onboarding items to show.</p>
}
else
{
 
    @foreach (var group in Model.GroupBy(x => x.type))
    {
        <div class="mb-6">

           
            <ul class="list-none space-y-3">
                @foreach (var item in group)
                {

                        <a href="#" class="text-lg font-bold mb-3">
                @item.title
                            </a>
                    <li class="list-none p-0 m-0 space-y-3">

                        @* Checkbox Type *@
                        @if (item.type.Equals("Checkbox", StringComparison.OrdinalIgnoreCase))
                        {
                            <input type="checkbox"
                                   disabled
                                   class="mt-1"
                                   @(!item.isactive ? "checked" : "") />

                            <span class="text-sm">
                                @item.description
                            </span>
                        }
                        else
                        {
                            <div>
                                <div class="font-semibold">@item.title</div>

                                @if (!string.IsNullOrWhiteSpace(item.description))
                                {
                                    @* URL Type *@
                                    @if (item.type.Equals("URL", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a href="@item.description"
                                           target="_blank"
                                           class="text-sm text-blue-600 underline">
                                            @item.description
                                        </a>
                                    }
                                    else
                                    {
                                        @* Text Type *@
                                        <div class="text-sm text-muted-foreground">
                                            @item.description
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    }

 
}