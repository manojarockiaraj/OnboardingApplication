@model IEnumerable<OnboardingApp.Models.OnBoardingList>

@{
    // Make a safe list
    var items = Model?.ToList() ?? new List<OnboardingApp.Models.OnBoardingList>();

    // Summary counts
    var totalItems = items.Count;
    var completedItems = items.Count(x => !x.isactive);
    var pendingItems = totalItems - completedItems;

    // Welcome Pack items (title contains 'Welcome')
    var welcomePack = items
        .Where(x => x.title.Contains("Welcome", StringComparison.OrdinalIgnoreCase))
        .ToList();

    // Other onboarding items
    var onboardingItems = items.Except(welcomePack).ToList();
}

@if (!items.Any())
{
    <div class="alert alert-secondary text-center">
        No onboarding items available.
    </div>
}
else
{
    <!-- ================= SUMMARY ================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4 class="mb-1">Welcome Aboard 👋</h4>
            <p class="text-muted mb-3">
                Here's your onboarding progress
            </p>

            <div class="row text-center mb-3">
                <div class="col">
                    <h5>@totalItems</h5>
                    <small class="text-muted">Total</small>
                </div>
                <div class="col">
                    <h5>@completedItems</h5>
                    <small class="text-muted">Completed</small>
                </div>
                <div class="col">
                    <h5>@pendingItems</h5>
                    <small class="text-muted">Pending</small>
                </div>
            </div>

            <div class="progress">
                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width:@(totalItems == 0 ? 0 : completedItems * 100 / totalItems)%">
                </div>
            </div>
        </div>
    </div>

    <!-- ================= WELCOME PACK ================= -->
    @if (welcomePack.Any())
    {
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white fw-semibold">
                🎁 Welcome Pack
            </div>

            <ul class="list-group list-group-flush">
                @foreach (var item in welcomePack.OrderBy(x => x.Id))
                {
                    <li class="list-group-item">
                        <div class="fw-semibold">@item.title</div>
                        <div class="text-muted small">@item.description</div>
                    </li>
                }
            </ul>
        </div>
    }

    <!-- ================= ONBOARDING ITEMS BY TYPE ================= -->
    @foreach (var typeGroup in onboardingItems.GroupBy(x => x.type))
    {
        @if (typeGroup.Key.Equals("Checkbox", StringComparison.OrdinalIgnoreCase))
        {
            <!-- Checkbox items grouped by Title -->
            @foreach (var titleGroup in typeGroup.GroupBy(x => x.title))
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-header fw-bold">
                        @titleGroup.Key
                    </div>

                    <ul class="list-group list-group-flush">
                        @foreach (var item in titleGroup.OrderBy(x => x.Id))
                        {
                            <li class="list-group-item">
                                <div class="d-flex align-items-start gap-3">
                                    <input type="checkbox"
                                           class="form-check-input mt-1"
                                           disabled
                                           checked="@(item.isactive)" />

                                    <div class="flex-grow-1">
                                        <div>@item.description</div>
                                    </div>

                                    @if (!item.isactive)
                                    {
                                        <span class="badge bg-success ms-auto">Done</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
        else
        {
            <!-- Text & URL items -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header d-flex justify-content-between">
                    <span class="fw-bold">@typeGroup.Key</span>
                    <span class="badge bg-secondary">@typeGroup.Count()</span>
                </div>

                <ul class="list-group list-group-flush">
                    @foreach (var item in typeGroup.OrderBy(x => x.Id))
                    {
                        <li class="list-group-item">
                            <div class="fw-semibold">@item.title</div>

                            @if (typeGroup.Key.Equals("URL", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@item.description" target="_blank" rel="noopener" class="link-primary">
                                    Open link
                                </a>
                            }
                            else
                            {
                                <div class="text-muted small">@item.description</div>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    }
}
