@* Reusable dismissible validation summary partial *@
<div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade d-none" id="formValidationSummary" role="alert">
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    <ul class="mb-0"></ul>
</div>

<script>
    (function () {
        function syncSummary() {
            var summary = document.getElementById('formValidationSummary');
            if (!summary) return;
            var list = summary.querySelector('ul');
            // Move messages from default validation summary area generated by asp-validation-summary
            // The server will populate the div contents (li items) when returning the view. If li's exist, show.
            var lis = summary.querySelectorAll('li');
            if (lis.length) {
                summary.classList.add('show');
                summary.classList.remove('d-none');
            }
        }

        document.addEventListener('DOMContentLoaded', function () { syncSummary(); });
    })();
</script>