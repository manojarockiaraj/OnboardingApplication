@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            var summary = document.getElementById('validationSummary');

            function applyInvalidState() {
                var lis = summary.querySelectorAll('li');
                if (lis.length) {
                    summary.classList.remove('d-none');
                }
                var errors = document.querySelectorAll('.text-danger');
                errors.forEach(function (err) {
                    if (err.textContent.trim().length > 0) {
                        var container = err.closest('.mb-3');
                        if (container) {
                            var input = container.querySelector('input, textarea, select');
                            if (input) input.classList.add('is-invalid');
                        }
                    }
                });
            }

            document.addEventListener('DOMContentLoaded', function () {
                applyInvalidState();
                var form = document.querySelector('form[asp-action="Edit"]') || document.querySelector('form');
                if (form) {
                    form.addEventListener('submit', function () {
                        setTimeout(applyInvalidState, 50);
                    });
                }
            });
        })();
    </script>
}
