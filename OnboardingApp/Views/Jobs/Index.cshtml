@model IEnumerable<OnboardingApp.Models.JobPosting>
@{
    ViewData["Title"] = "Job Listings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Job Listings</h1>
    <div>
        <a class="btn btn-primary" asp-action="Create">+ Add Job</a>        
    </div>
</div>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Skills</th>
            <th>Client</th>
            @*<th>Contact</th>*@
            <th>Location</th>
            <th>Start Date</th>
            <th>Client Evaluation</th>
            @*<th>Client Contract</th>*@
            <th>Work Model</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var job in Model)
    {
        <tr>
            <td>@job.Title</td>
            <td>@job.Skills</td>
            <td>@job.ClientName</td>
            @*<td>@job.ClientContact</td>*@
            <td>@job.Location</td>
            <td>@(job.StartDate?.ToString("yyyy-MM-dd") ?? "")</td>
            <td>@(job.ClientEvaluation ? "Yes" : "No")</td>
            @*<td>@job.ClientContract</td>*@
            <td>@job.WorkModel</td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@job.Id">Edit</a>
                
            </td>
            <td>
                <a class="btn btn-sm btn-info" asp-controller="Candidates" asp-action="Index" asp-route-jobId="@job.Id">Candidates</a>
            </td>
        </tr>
    }
    </tbody>
</table>
