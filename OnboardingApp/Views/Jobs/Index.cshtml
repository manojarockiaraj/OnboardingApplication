@model IEnumerable<OnboardingApp.Models.JobPosting>
@{
    ViewData["Title"] = "Job Listings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Job Listings</h1>
    @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole("Operation") || User.IsInRole("AccountManager")))
    {
        <a class="btn btn-primary btn-lg" asp-action="Create">+ Add Job</a>
    }
    else
    {
        <button class="btn btn-primary btn-lg" disabled>+ Add Job</button>
    }
</div>

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var job in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <!-- Job Title and Skills with icons -->
                    <h5 class="card-title">
                        <i class="bi bi-briefcase-fill me-2"></i> @job.Title
                    </h5>
                    <p class="text-muted mb-3">
                        <i class="bi bi-gear-fill me-2"></i> @job.Skills
                    </p>

                    <!-- Job Details List -->
                    <ul class="list-group list-group-flush mb-3">
                        <li class="list-group-item">
                            <i class="bi bi-person-fill me-2"></i> <strong>Client:</strong> @job.ClientName
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-geo-alt-fill me-2"></i> <strong>Location:</strong> @job.Location
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-calendar-event-fill me-2"></i> <strong>Start Date:</strong> @(job.StartDate?.ToString("yyyy-MM-dd") ?? "N/A")
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-house-fill me-2"></i> <strong>Work Model:</strong>
                            @if (job.WorkModel == "Remote")
                            {
                                <span class="badge bg-primary">@job.WorkModel</span>
                            }
                            else if (job.WorkModel == "Onsite")
                            {
                                <span class="badge bg-success">@job.WorkModel</span>
                            }
                            else if (job.WorkModel == "Hybrid")
                            {
                                <span class="badge bg-warning text-dark">@job.WorkModel</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@job.WorkModel</span>
                            }
                        </li>
                        <li class="list-group-item">
                            <i class="bi @(job.ClientEvaluation == true ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") me-2"></i>
                            <strong>Client Evaluation:</strong> @(job.ClientEvaluation == true ? "Yes" : job.ClientEvaluation == false ? "No" : "N/A")
                        </li>
                    </ul>

                    <!-- Action Buttons -->
                    <div class="mt-auto d-flex justify-content-end gap-2">
                        @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole("AccountManager") || User.IsInRole("Operation")))
                        {
                            <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@job.Id">Edit</a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled>Edit</button>
                        }

                        <!-- View Button -->
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#viewJobModal-@job.Id">
                            View
                        </button>

                        @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole("AccountManager")))
                        {
                            <a class="btn btn-sm btn-info" asp-controller="Candidates" asp-action="AssignCandidates" asp-route-jobId="@job.Id">Assign Candidates</a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-info" disabled>Assign Candidates</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="viewJobModal-@job.Id" tabindex="-1" aria-labelledby="viewJobModalLabel-@job.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <!-- Modal Header -->
                    <div class="modal-header justify-content-center bg-light">
                        <h5 class="modal-title fw-bold text-center text-primary" id="viewJobModalLabel-@job.Id">
                            Job Details - @job.Title
                        </h5>
                        <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body">
                        <!-- Job Description -->
                        @if (!string.IsNullOrEmpty(job.Description))
                        {
                            <div class="mb-3">
                                <h6 class="fw-bold">Job Description:</h6>
                                <p>@job.Description</p>
                            </div>
                        }

                        <!-- Job Details List -->
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">
                                <i class="bi bi-person-fill me-2"></i> <strong>Client:</strong> @job.ClientName
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-geo-alt-fill me-2"></i> <strong>Location:</strong> @job.Location
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-calendar-event-fill me-2"></i> <strong>Start Date:</strong> @(job.StartDate?.ToString("yyyy-MM-dd") ?? "N/A")
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-house-fill me-2"></i> <strong>Work Model:</strong>
                                @if (job.WorkModel == "Remote")
                                {
                                    <span class="badge bg-primary">@job.WorkModel</span>
                                }
                                else if (job.WorkModel == "Onsite")
                                {
                                    <span class="badge bg-success">@job.WorkModel</span>
                                }
                                else if (job.WorkModel == "Hybrid")
                                {
                                    <span class="badge bg-warning text-dark">@job.WorkModel</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@job.WorkModel</span>
                                }
                            </li>
                            <li class="list-group-item">
                                <i class="bi bi-gear-fill me-2"></i> <strong>Skills:</strong> @job.Skills
                            </li>
                            <li class="list-group-item">
                                <i class="bi @(job.ClientEvaluation == true ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") me-2"></i>
                                <strong>Client Evaluation:</strong> @(job.ClientEvaluation == true ? "Yes" : job.ClientEvaluation == false ? "No" : "N/A")
                            </li>
                        </ul>
                    </div>

                    <!-- Modal Footer -->
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

    }
</div>

<!-- Make sure Bootstrap JS is included -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
