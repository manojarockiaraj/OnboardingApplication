@model IEnumerable<OnboardingApp.Models.Candidate>
@{
    ViewData["Title"] = "Candidates";
    var jobId = ViewData["JobId"] as int?;
    var jobTitle = ViewData["JobTitle"] as string;
}

<h1>Candidates @if(!string.IsNullOrEmpty(jobTitle)){ <text>for "@jobTitle"</text> }</h1>

@if (jobId == null)
{
    <p>Showing all candidates. You can filter by job using the Jobs list.</p>
}
else
{
    <p>Showing candidates matched to job: @jobTitle</p>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Skills</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach(var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>@c.Skills</td>
            <td>@c.Email</td>
            <td>@c.Phone</td>
            <td>@c.Location</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@c.Id" asp-route-jobId="@jobId">Details</a>
            </td>
        </tr>
    }
    </tbody>
</table>
