@model OnboardingApp.Models.Candidate

@{
    ViewData["Title"] = "Candidate Details";

    var jobClientEvalObj = ViewData["JobClientEvaluation"];
    bool showClientInterview = jobClientEvalObj is bool b && b;

    var evaluation = Model.CandidateStatusEvaluations?.FirstOrDefault();
}

@functions {
    string GetStatusBadgeClass(object status)
    {
        if (status == null) return "bg-secondary";
        var value = status.ToString();
        return value switch
        {
            "Submitted" => "bg-info",
            "Under Review" => "bg-warning text-dark",
            "Shortlisted" => "bg-primary",
            "Rejected" => "bg-danger",
            "OnHold" => "bg-secondary",
            "NotScheduled" => "bg-secondary",
            "Scheduled" => "bg-info",
            "Completed" => "bg-primary",
            "Selected" => "bg-success",
            "NoShow" => "bg-dark",
            "Awaiting Schedule" => "bg-info",
            "Feedback Pending" => "bg-warning text-dark",
            "InProgress" => "bg-warning text-dark",
            "Offered" => "bg-primary",
            "Offer Accepted" => "bg-success",
            "Offer Rejected" => "bg-danger",
            "Joined" => "bg-success",
            "Dropped" => "bg-dark",
            "NotInitiated" => "bg-secondary",
            "Cleared" => "bg-success",
            "Failed" => "bg-danger",
            "True" => "bg-success",
            "False" => "bg-secondary",
            _ => "bg-light text-dark"
        };
    }
}

<h1 class="mb-4">Candidate | Progress</h1>

<!-- Candidate Basic Info -->
<div class="card p-3 shadow-sm">
    <!-- Header -->
    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-person-circle me-3 text-primary" style="font-size: 2rem;"></i>
        <div>
            <div class="text-muted small">Candidate Profile</div>
            <h4 class="mb-0 fw-bold">@Model.Name</h4>
        </div>
    </div>

    <!-- Body -->
    <div class="row g-3">
        <!-- Skills -->
        <div class="col-md-6">
            <div class="d-flex align-items-center p-3 border rounded shadow-sm h-100">
                <i class="bi bi-gear-fill text-primary me-3" style="font-size:1.5rem;"></i>
                <div>
                    <div class="text-muted small">Skills</div>
                    <div class="fw-bold">@Model.Skills</div>
                </div>
            </div>
        </div>

        <!-- Email -->
        <div class="col-md-6">
            <div class="d-flex align-items-center p-3 border rounded shadow-sm h-100">
                <i class="bi bi-envelope-fill text-primary me-3" style="font-size:1.5rem;"></i>
                <div class="w-100">
                    <div class="text-muted small">Email</div>
                    <div class="fw-bold">@Model.Email</div>
                </div>
            </div>
        </div>

        <!-- Phone -->
        <div class="col-md-6">
            <div class="d-flex align-items-center p-3 border rounded shadow-sm h-100">
                <i class="bi bi-telephone-fill text-primary me-3" style="font-size:1.5rem;"></i>
                <div class="w-100">
                    <div class="text-muted small">Phone</div>
                    <div class="fw-bold">@Model.Phone</div>
                </div>
            </div>
        </div>

        <!-- Location -->
        <div class="col-md-6">
            <div class="d-flex align-items-center p-3 border rounded shadow-sm h-100">
                <i class="bi bi-geo-alt-fill text-primary me-3" style="font-size:1.5rem;"></i>
                <div class="w-100">
                    <div class="text-muted small">Location</div>
                    <div class="fw-bold">@Model.Location</div>
                </div>
            </div>
        </div>

        <!-- Summary (full width) -->
        <div class="col-12">
            <div class="d-flex p-3 border rounded shadow-sm">
                <i class="bi bi-card-text text-primary me-3" style="font-size:1.5rem;"></i>
                <div class="w-100">
                    <div class="text-muted small">Summary</div>
                    <div class="fw-bold">@Model.Summary</div>
                </div>
            </div>
        </div>
    </div>
</div>


@if (evaluation == null)
{
    <div class="alert alert-warning">
        No evaluation record found for this candidate and job.
    </div>
}
else
{
    <!-- Interviewers -->
    <h3 class="mt-4"><i class="bi bi-people-fill me-2"></i>Interviewers</h3>
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted"><i class="bi bi-person-badge me-1"></i>CTS Internal Interviewer</h6>
                    <strong>@evaluation.CtsInternalInterviewerName</strong>
                </div>
            </div>
        </div>

        @if (showClientInterview)
        {
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted"><i class="bi bi-person-badge me-1"></i>Client Interviewer</h6>
                        <strong>@evaluation.ClientInterviewerName</strong>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Statuses -->
    <h3 class="mt-4"><i class="bi bi-bar-chart-fill me-2"></i>Status</h3>
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body">
                    <h6 class="text-muted"><i class="bi bi-file-earmark-text me-1"></i>Resume</h6>
                    <span class="badge @GetStatusBadgeClass(evaluation.ResumeStatus.ToString())">
                        @evaluation.ResumeStatus
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body">
                    <h6 class="text-muted"><i class="bi bi-person-workspace me-1"></i>CTS Internal Interview</h6>
                    <span class="badge @GetStatusBadgeClass(evaluation.CtsInternalInterviewStatus.ToString())">
                        @evaluation.CtsInternalInterviewStatus
                    </span>
                </div>
            </div>
        </div>

        @if (showClientInterview)
        {
            <div class="col-md-3">
                <div class="card h-100 shadow-sm text-center">
                    <div class="card-body">
                        <h6 class="text-muted"><i class="bi bi-people-fill me-1"></i>Client Interview</h6>
                        <span class="badge @GetStatusBadgeClass(evaluation.ClientInterviewStatus.ToString())">
                            @evaluation.ClientInterviewStatus
                        </span>
                    </div>
                </div>
            </div>
        }

        <div class="col-md-3">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body">
                    <h6 class="text-muted"><i class="bi bi-award-fill me-1"></i>Final Status</h6>
                    <span class="badge @GetStatusBadgeClass(evaluation.FinalStatus.ToString())">
                        @evaluation.FinalStatus
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 shadow-sm text-center">
                <div class="card-body">
                    <h6 class="text-muted"><i class="bi bi-shield-fill-check me-1"></i>BPSS Status</h6>
                    <span class="badge @GetStatusBadgeClass(evaluation.SecurityCheckStatus.ToString())">
                        @evaluation.SecurityCheckStatus
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <form asp-action="SubmitOnboarding" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit"
                class="btn btn-success me-2"
                @(evaluation.FinalStatus == OnboardingApp.Models.FinalStatus.InProgress && evaluation.SecurityCheckStatus == OnboardingApp.Models.SecurityCheckStatus.Cleared ? "" : "disabled")>
            Submit Onboarding Request
        </button>

        <a class="btn btn-primary me-2"
           asp-action="EditStatus"
           asp-route-id="@Model.Id"
           asp-route-jobId="@ViewData["JobId"]">
            Edit Status
        </a>

        <a class="btn btn-secondary"
           asp-action="Index"
           asp-route-jobId="@ViewData["JobId"]">
            Back
        </a>
    </form>
}
