 @{
    Layout = null; // standalone
    ViewBag.Title = "Submission Confirmed";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Your site CSS -->
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h3 class="mb-0">Submission Confirmed</h3>
                    </div>
                    <div class="card-body">
                        <p class="lead">
                            Thank you for your submission! We have successfully received your information and it has been recorded in our system.
                        </p>
                        <p>
                            You will receive a confirmation email shortly. Please keep this acknowledgment for your records.
                        </p>

                        <ul>
                            @*<li>Reference ID: <strong>@ViewBag.ReferenceId</strong></li>*@
                            <li>Submission Date: <strong>@DateTime.Now.ToString("MMMM dd, yyyy HH:mm")</strong></li>
                            <li>Status: <strong>Received and Under Review</strong></li>
                        </ul>

                        <p>
                            If you have any questions or need further assistance, please contact our support team at
                            <a href="mailto:datadigitalteam@cognizant.com">datadigitalteam@cognizant.com</a>.
                        </p>

                        @*<div class="text-center mt-4">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Back to Home</a>
                        </div>*@
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS (optional, if needed for components) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
